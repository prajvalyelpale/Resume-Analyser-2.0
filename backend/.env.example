# Backend environment variables – copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.

APP_NAME=Resume AI Analyzer
DEBUG=false

# Comma-separated list of allowed CORS origins.
# Local: leave as-is (Vite dev server is the default in code).
# Production: set this to your Vercel frontend URL.
# ALLOWED_ORIGINS=https://resume-analyser-2-0.vercel.app

# --- Database (not connected yet) ---
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

